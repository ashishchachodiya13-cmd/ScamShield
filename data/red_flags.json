      "patterns": [
        "\\b(lottery|lucky\\s+draw|won\\s+(?:a\\s+)?(?:prize|car|cash|crore|lakh)|cashback)\\b",
        "\\b(kbc\\s+(?:lottery|winner|crorepati)|congratulations\\s+you\\s+have\\s+won)\\b",
        "\\b(gift\\s+voucher|reward\\s+points|bonus\\s+prize|jackpot)\\b",
        "\\b(lottery\\s+lag\\s+gayi|inaam\\s+jeeta|prize\\s+mila|lucky\\s+winner)\\b",
