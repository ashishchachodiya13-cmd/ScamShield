        "\\b(loan\\s+(?:approval|sanction|processing)\\s+fee|security\\s+deposit)\\b",
        "\\b(work\\s+from\\s+home\\s+deposit|daily\\s+earning\\s+fee|joining\\s+fee)\\b",
