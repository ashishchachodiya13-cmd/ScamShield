  "flags": [
    {
      "id": "authority_impersonation",
      "name_en": "Authority Impersonation",
      "name_hi": "अधिकारी का झूठा दिखावा",
      "description_en": "Claims to be from CBI, police, customs, RBI, courts, or senior bank officials.",
      "description_hi": "सीबीआई, पुलिस, कस्टम्स, आरबीआई, अदालत या बैंक अधिकारी होने का झूठा दावा।",
      "weight": 3,
      "patterns": [
        "\\b(cbi|police|customs|rbi|ed|enforcement\\s+directorate|narcotics|ncb|nia|cid)\\b",
        "\\b(cbi\\s+officer|police\\s+officer|customs\\s+officer|bank\\s+officer|rbi\\s+officer)\\b",
        "\\b(crime\\s+branch|cyber\\s+crime\\s+cell|police\\s+station|thana|thane\\s+se)\\b",
        "\\b(supreme\\s+court|high\\s+court|magistrate|judge|arrest\\s+warrant|court\\s+order)\\b",
        "(सीबीआई|पुलिस|कस्टम्स|आरबीआई|प्रवर्तन\\s*निदेशालय|नारकोटिक्स|क्राइम\\s*ब्रांच|थाना|अदालत|वारंट|जज|मजिस्ट्रेट)",
        "\\b(cbi\\s+bol\\s+raha|police\\s+se\\s+bol|custom\\s+se|dsp|sp\\s+officer|inspector)\\b"
      ]
    },
    {
      "id": "urgency_threat",
      "name_en": "Urgency or Threat",
      "name_hi": "जल्दबाजी या डराना-धमकाना",
      "description_en": "Pressures you to act immediately, threatens arrest, penalties, or immediate blocking.",
      "description_hi": "तुरंत कार्रवाई करने का दबाव, गिरफ्तारी, जुर्माना या सेवा बंद करने की धमकी।",
      "weight": 2,
      "patterns": [
        "\\b(turant|urgent|urgently|immediately|right\\s+now|without\\s+delay|at\\s+once)\\b",
        "\\b(within\\s+(?:24|12|48|2|1|few)\\s*(?:hours|hrs|hours?|ghante?))\\b",
        "\\b(arrest\\s+(?:warrant|threat|ho\\s+jayega|kar\\s+lenge)|jail\\s+bhej|jail\\s+hogi)\\b",
        "\\b(account\\s+(?:will\\s+be\\s+)?(?:blocked|suspended|terminated|frozen|closed))\\b",
        "\\b(legal\\s+action|police\\s+complaint|fir\\s+register|penal(?:ty|ized)|hathkadi)\\b",
        "(तुरंत|जल्दी|तत्काल|२४\\s*घंटे|24\\s*घंटे|गिरफ्तारी|जेल|खाता\\s*बंद|कानूनी\\s*कार्रवाई|वारंट|एफआईआर|हथकड़ी|अन्यथा)",
        "\\b(aaj\\s+hi|abhi\\s+karein|abhi\\s+karo|nahi\\s+toh\\s+arrest|action\\s+hoga)\\b"
      ]
    },
    {
      "id": "sensitive_info",
      "name_en": "Request for Sensitive Information",
      "name_hi": "गोपनीय जानकारी मांगना",
      "description_en": "Asks for passwords, OTPs, UPI PINs, CVV, or card/bank account details.",
      "description_hi": "ओटीपी, यूपीआई पिन, सीवीवी, पासवर्ड, या कार्ड व बैंक खाते का विवरण मांगना।",
      "weight": 3,
      "patterns": [
        "(?<!do not\\s)(?<!don't\\s)(?<!never\\s)\\b(share|send|enter|tell|verify)\\s+(?:your\\s+)?(?:upi\\s*)?(?:otp|pin|cvv|password|details)\\b",
        "\\b(otp|one\\s+time\\s+password|upi\\s*pin|cvv)\\s+(?:share|batao|bhejo|enter|daalein)\\b",
        "\\b(card\\s+number|netbanking\\s+password|debit\\s+card\\s+pin)\\s+(?:batao|bhejo|enter)\\b",
        "(?<!न\\s)(?<!मत\\s)(ओटीपी|पिन|सीवीवी|पासवर्ड)\\s*(?:बताएं|दीजिए|शेयर|भेजें|दर्ज\\s*करें)"
      ]
    },
    {
      "id": "secrecy_demand",
      "name_en": "Secrecy Demand",
      "name_hi": "गोपनीयता या राज रखने का दबाव",
      "description_en": "Demands you not tell family or anyone, or stay isolated on call.",
      "description_hi": "परिवार या किसी और को न बताने अथवा अकेले रहने का दबाव बनाना।",
      "weight": 3,
      "patterns": [
        "\\b(do\\s+not|don'?t|never)\\s+tell\\s+(anyone|anybody|family|police|bank)\\b",
        "\\b(kisi\\s+ko\\s+(?:bhi\\s+)?mat\\s+batana|kisi\\s+ko\\s+mat\\s+batao|kisi\\s+se\\s+mat\\s+keh(\\w+)?)\\b",
        "\\b(keep\\s+(?:it\\s+)?(?:secret|confidential)|confidential\\s+investigation)\\b",
        "\\b(do\\s+not\\s+disconnect|don'?t\\s+cut\\s+the\\s+call|call\\s+mat\\s+kaatna)\\b",
        "\\b(stay\\s+in\\s+(?:a\\s+)?room\\s+alone|akele\\s+me\\s+baitho|akele\\s+raho)\\b",
        "(किसी\\s*को\\s*मत\\s*बताना|किसी\\s*को\\s*न\\s*बताएं|गोपनीय|सीक्रेट|कॉल\\s*मत\\s*काटना|अकेले\\s*रहो)"
      ]
    },
    {
      "id": "immediate_payment",
      "name_en": "Immediate Payment Demand",
      "name_hi": "तुरंत पैसे भेजने की मांग",
      "description_en": "Demands transferring money, moving funds to a 'safe account', or paying a penalty.",
      "description_hi": "पैसे ट्रांसफर करने, 'सुरक्षित खाते' में पैसे डालने या जुर्माना भरने को कहना।",
      "weight": 3,
      "patterns": [
        "\\b(transfer\\s+(?:money|amount|funds|cash|rs|inr|\\d+)|send\\s+money)\\b",
        "\\b(transfer\\s+kijiye|transfer\\s+karo|paise\\s+bhejo|paise\\s+daalo|amount\\s+bhejo)\\b",
        "\\b(safe\\s+account|rbi\\s+safe\\s+account|government\\s+safe\\s+account|suraksha\\s+account)\\b",
        "\\b(pay\\s+(?:fee|fine|penalty|charges|clearance|security\\s+deposit))\\b",
        "\\b(deposit\\s+(?:money|amount|funds|kijiye)|jurmana\\s+bharo|penalty\\s+bharo)\\b",
        "(पैसे\\s*भेजें|पैसे\\s*ट्रांसफर|सुरक्षित\\s*खाते|सुरक्षित\\s*खाता|फीस\\s*जमा|जुर्माना\\s*भरें|रुपये\\s*भेजो|तुरंत\\s*भेजें)"
      ]
    },
    {
      "id": "prize_reward",
      "name_en": "Prize or Reward Claim",
      "name_hi": "लॉटरी या इनाम का झूठा दावा",
