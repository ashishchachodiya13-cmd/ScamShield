        "\\b(anydesk|teamviewer|rustdesk|quicksupport|airdroid)\\b",
        "\\b(download\\s+(?:the\\s+)?(?:app|apk)|install\\s+(?:the\\s+)?(?:app|apk))\\b",
        "\\b(click\\s+(?:on\\s+)?(?:this\\s+)?link|link\\s+par\\s+click|app\\s+install\\s+karo)\\b",
        "(लिंक\\s*पर\\s*क्लिक|ऐप\\s*डाउनलोड|एपीके\\s*इंस्टॉल|एनीडेस्क|टीमव्यूअर)"
      ]
    },
    {
      "id": "kyc_account_block",
      "name_en": "KYC or Account-Block Pretext",
      "name_hi": "केवाईसी या खाता ब्लॉक का बहाना",
      "description_en": "Falsely claims your KYC is expired, PAN is suspended, or bank account is blocked.",
      "description_hi": "केवाईसी समाप्त होने, पैन निलंबित होने या खाता बंद होने का झूठा दावा।",
      "weight": 2,
      "patterns": [
        "\\b(update\\s+kyc|kyc\\s+(?:is\\s+)?(?:pending|expired|suspended|incomplete))\\b",
        "\\b(pan\\s+(?:card\\s+)?(?:suspended|blocked|inactive|deactivated))\\b",
        "\\b((?:electricity|power\\s+supply)\\s+(?:will\\s+be\\s+)?(?:cut|disconnected|stopped)|bijli\\s+cut\\s+jayegi)\\b",
        "\\b(sim\\s+(?:card\\s+)?(?:block|deactivated|disconnected)|sim\\s+band)\\b",
