      ]
    },
    {
      "id": "suspicious_link_app",
      "name_en": "Suspicious Link or App Download",
      "name_hi": "संदिग्ध लिंक या ऐप डाउनलोड",
      "description_en": "Urges clicking shortened links or downloading screen-sharing / remote-access apps.",
      "description_hi": "अज्ञात लिंक पर क्लिक करने या एनीडेस्क, टीमव्यूअर जैसी ऐप इंस्टॉल करने को कहना।",
      "weight": 2,
      "patterns": [
