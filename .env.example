# Google Gemini API key for plain-language explanations
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Path to tesseract executable if not in system PATH
# Windows default example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# Application Environment: dev or production
APP_ENV=dev

# JWT Secret Key (required in production; refuse startup if default in production)
JWT_SECRET=dev-secret-change-in-production-min-32-chars-long

# Cookie security: false in dev, true in production
COOKIE_SECURE=false
