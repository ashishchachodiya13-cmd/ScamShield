{
  "name": "ScamShield — AI Scam Defense for Senior Citizens",
  "short_name": "ScamShield",
  "start_url": "/#scan",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#101828",
  "theme_color": "#101828",
  "description": "Decision-support tool helping senior citizens in India detect suspicious messages, calls, and fraud.",
  "categories": ["security", "utilities"],
  "icons": [
    {
      "src": "/static/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/static/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": ["image/png", "image/jpeg", "image/jpg", "image/webp"]
        }
      ]
    }
  }
}
